;*******************************************************************
;	MAPDEBUG.A99 - Paged Memory Mapper Debug Utility
;	TMS99105 SBC V4
;	Load at 0x0500 (COMMON)
;
;	Parameters at fixed addresses - edit then run 500G:
;
;	0502: COMMAND
;	0504: SEG_PAGE   HIGH BYTE=PAGE(0-15)  LOW BYTE=SEG(0-15)
;	0506: VALUE      value to write (CMD 5)
;
;	COMMANDS:
;	1=PSEN  2=PSDIS  3=SMREG  4=RMREG  5=WPGSEG  6=RPGSEG
;	7=CLR   8=LST    9=RDLP   A=PGLP   B=HLP     C=SETALL
;	D=SCYC  E=INIT   F=CODE
;*******************************************************************

	DXOP	WHEX,10
	DXOP	MESG,14
	DXOP	PSEL,2

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R9	EQU	9
R11	EQU	11
R12	EQU	12
MAP_PORT	EQU	R12

MAP_BASE_PORT	EQU	80C0H
BYTEWIDE	EQU	2

PSEL_DISABLE	EQU	0000H
PSEL_ENABLE	EQU	0100H

CMD_PSEL_EN	EQU	1
CMD_PSEL_DIS	EQU	2
CMD_MAPREG_WR	EQU	3
CMD_MAPREG_RD	EQU	4
CMD_SEG_WR	EQU	5
CMD_SEG_RD	EQU	6
CMD_MAP_CLR	EQU	7
CMD_MAP_LST	EQU	8
CMD_RDLOOP	EQU	9
CMD_PGLOOP	EQU	10
CMD_HELP	EQU	11
CMD_SEGLOOP	EQU	12
CMD_SEGCYC	EQU	13
CMD_INIT	EQU	14
CMD_CODETEST	EQU	15

	AORG	0500H

	JMP	START

;--- Parameters at fixed addresses ---
COMMAND:	WORD	CMD_MAPREG_WR	;0502: COMMAND
SEG_PAGE:	WORD	0102H		;0504: HIGH=PAGE LOW=SEG
VALUE:		WORD	0A5A5H		;0506: WRITE VALUE

START:
	LWPI	0250H
	LI	R9,PSEL_DISABLE		;DISABLE PSEL IMMEDIATELY
	PSEL	R9

;--- Print banner ---
	MESG	@TXT_BANNER

;--- Dispatch ---
	MOV	@COMMAND,R0
	CI	R0,CMD_PSEL_EN
	JNE	D2
	B	@DO_PSEL_EN
D2	CI	R0,CMD_PSEL_DIS
	JNE	D3
	B	@DO_PSEL_DIS
D3	CI	R0,CMD_MAPREG_WR
	JNE	D4
	B	@DO_MAPREG_WR
D4	CI	R0,CMD_MAPREG_RD
	JNE	D5
	B	@DO_MAPREG_RD
D5	CI	R0,CMD_SEG_WR
	JNE	D6
	B	@DO_SEG_WR
D6	CI	R0,CMD_SEG_RD
	JNE	D7
	B	@DO_SEG_RD
D7	CI	R0,CMD_MAP_CLR
	JNE	D8
	B	@DO_MAP_CLR
D8	CI	R0,CMD_MAP_LST
	JNE	D9
	B	@DO_MAP_LST
D9	CI	R0,CMD_RDLOOP
	JNE	D10
	B	@DO_RDLOOP
D10	CI	R0,CMD_PGLOOP
	JNE	D11
	B	@DO_PGLOOP
D11	CI	R0,CMD_HELP
	JNE	D12
	B	@DO_HELP
D12	CI	R0,CMD_SEGLOOP
	JNE	D13
	B	@DO_SEGLOOP
D13	CI	R0,CMD_SEGCYC
	JNE	D14
	B	@DO_SEGCYC
D14	CI	R0,CMD_INIT
	JNE	D15
	B	@DO_INIT
D15	CI	R0,CMD_CODETEST
	JNE	DBAD
	B	@DO_CODETEST
DBAD	MESG	@TXT_BADCMD
	B	@EXIT

;--- CMD 1: Enable PSEL ---
DO_PSEL_EN:
	LI	R9,PSEL_ENABLE
	PSEL	R9
	MESG	@TXT_PSEL_EN
	B	@EXIT

;--- CMD 2: Disable PSEL ---
DO_PSEL_DIS:
	LI	R9,PSEL_DISABLE
	PSEL	R9
	MESG	@TXT_PSEL_DIS
	B	@EXIT

;--- CMD 3: Write map register, read back verify ---
DO_MAPREG_WR:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;PAGE
	MOV	R0,R1			;SAVE PAGE
	BL	@MAP_SET

	MESG	@TXT_MWRSEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;PRINT SEGMENT
	MESG	@TXT_PAGE
	WHEX	R1			;PRINT PAGE
	MESG	@TXT_NL

	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH
	BL	@MAP_GET		;R0 = READBACK
	MESG	@TXT_READBACK
	WHEX	R0
	MESG	@TXT_NL
	B	@EXIT

;--- CMD 4: Read map register ---
DO_MAPREG_RD:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	BL	@MAP_GET		;R0 = READBACK FROM 6116
	MESG	@TXT_MRDSEG
	MOV	@SEG_PAGE,R1
	ANDI	R1,00FFH
	WHEX	R1			;SEGMENT
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R1
	SWPB	R1
	ANDI	R1,00FFH
	WHEX	R1			;PAGE
	MESG	@TXT_READBACK
	WHEX	R0			;READBACK FROM 6116
	MESG	@TXT_NL
	B	@EXIT

;--- CMD 5: Write value to segment/page ---
DO_SEG_WR:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;PAGE
	BL	@MAP_SET		;1. CONFIGURE MAP REGISTER
	LI	R9,PSEL_ENABLE		;2. ENABLE PSEL
	PSEL	R9

	BL	@CALC_ADDR		;CALC ADDR BEFORE PSEL
	MOV	@VALUE,R1		;LOAD VALUE BEFORE PSEL

;	MOV	*R2,R3			;DUMMY READ - CLOCK SA TO CORRECT PAGE

	MOV	R1,*R2			;3. WRITE
	MESG	@TXT_WPGSEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;SEG
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0			;PAGE
	MESG	@TXT_NL
	MESG	@TXT_WROTE
	MOV	@VALUE,R0		;PRINT VALUE DIRECTLY
	WHEX	R0
	MESG	@TXT_SEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0
	MESG	@TXT_NL
	B	@EXIT

;--- CMD 6: Read from segment/page ---
DO_SEG_RD:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;PAGE
	BL	@MAP_SET		;1. CONFIGURE MAP REGISTER
	BL	@CALC_ADDR		;2. CALC ADDRESS
	LI	R9,PSEL_ENABLE		;3. ENABLE PSEL
	PSEL	R9
	MOV	*R2,R1			;4. READ
	MESG	@TXT_RPGSEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;SEG
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0			;PAGE
	MESG	@TXT_NL
	MESG	@TXT_READ
	MOV	R1,R0
	WHEX	R0
	MESG	@TXT_SEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0
	MESG	@TXT_NL
	B	@EXIT

;--- CMD 7: Clear all map registers to page 0 ---
DO_MAP_CLR:
	LI	MAP_PORT,MAP_BASE_PORT
	CLR	R1
	LI	R2,16
MCLR_L:	LDCR	R1,BYTEWIDE
	INCT	MAP_PORT
	DEC	R2
	JNE	MCLR_L
	MESG	@TXT_MAPCLR
	B	@EXIT

;--- CMD 8: List all map registers ---
DO_MAP_LST:
	CLR	R9
MLST_L:
	MESG	@TXT_SEG
	MOV	R9,R0
	WHEX	R0
	MESG	@TXT_PAGE
	MOV	R9,@MLST_SEG
	BL	@MAP_GET
	MOV	@MLST_SEG,R9
	WHEX	R0
	MESG	@TXT_NL
	INC	R9
	CI	R9,16
	JL	MLST_L
	B	@EXIT

;--- CMD 9: Read loop - continuous read from SEG:PAGE ---
DO_RDLOOP:
	MESG	@TXT_RDLOOP
	MESG	@TXT_NL
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	BL	@MAP_SET
	LI	R9,PSEL_ENABLE
	PSEL	R9
	BL	@CALC_ADDR
RDLP:	MOV	*R2,R1
	JMP	RDLP

;--- CMD A: Page loop - cycle all pages on segment ---
DO_PGLOOP:
	MESG	@TXT_PGLOOP
	MESG	@TXT_NL
	LI	R9,PSEL_ENABLE
	PSEL	R9
	MOV	@SEG_PAGE,R3
	ANDI	R3,00FFH		;R3 = SEGMENT
	MOV	R3,R2
	SWPB	R2
	ANDI	R2,0F000H		;R2 = SEGMENT BASE ADDRESS
PGLP:	CLR	R0
PGLP2:	MOV	R3,R9
	BL	@MAP_SET
	MOV	*R2,R1
	INC	R0
	CI	R0,16
	JL	PGLP2
	JMP	PGLP

;--- CMD B: Help ---
DO_HELP:
	MESG	@TXT_HELP
	B	@EXIT

;--- CMD C: Init seg N=page N for segs 0-14, seg 15=page 0 ---
DO_SEGLOOP:
	MESG	@TXT_SEGLOOP
	MESG	@TXT_NL
	CLR	R9			;START AT SEG 0
SINIT:
	MOV	R9,R0			;PAGE = SEGMENT
	MOV	R9,@MLST_SEG		;SAVE - MAP_SET CORRUPTS R9
	BL	@MAP_SET
	MOV	@MLST_SEG,R9		;RESTORE SEGMENT
	INC	R9
	CI	R9,15			;STOP AT SEG 14
	JL	SINIT
;--- Set seg 15 to page 0 ---
	LI	R9,15
	CLR	R0
	BL	@MAP_SET
	MESG	@TXT_DONE
	B	@EXIT

;--- CMD D: Segment cycle - PSEL boundaries for scope ---
DO_SEGCYC:
	MESG	@TXT_SEGCYC
	MESG	@TXT_NL
	MOV	@SEG_PAGE,R2
	ANDI	R2,00FFH		;SEGMENT
	SWPB	R2
	SLA	R2,4			;SEGMENT BASE ADDRESS
SCYC:
	LI	R9,PSEL_ENABLE
	PSEL	R9
	MOV	*R2+,R1
	LI	R9,PSEL_DISABLE
	PSEL	R9
	JMP	SCYC

;--- CMD E: Init seg N=page N for segs 0-14, seg 15=page 0 ---
DO_INIT:
	MESG	@TXT_INIT
	MESG	@TXT_NL
	CLR	R9			;START AT SEG 0
INITLP:
	MOV	R9,R0			;PAGE = SEGMENT
	MOV	R9,@MLST_SEG
	BL	@MAP_SET
	MOV	@MLST_SEG,R9
	INC	R9
	CI	R9,15			;SEGS 0-14
	JL	INITLP
	LI	R9,15
	CLR	R0
	BL	@MAP_SET
	MESG	@TXT_DONE
	B	@EXIT

;--- CMD F: Relocatable loader test ---
;    1. Sets seg2=page2 seg3=page3
;    2. Copies TEST_ROUTINE to page 2 at 0x2000
;    3. Writes 0xBEEF to page 3 at 0x3000
;    4. Calls routine at 0x2000
;    5. Verifies R0=BEEF (cross-page read from paged code)
DO_CODETEST:
	MESG	@TXT_CODETEST
	MESG	@TXT_NL
;--- SET MAP REGISTERS ---
	LI	R9,2
	LI	R0,2
	BL	@MAP_SET		;SEG2=PAGE2
	LI	R9,3
	LI	R0,3
	BL	@MAP_SET		;SEG3=PAGE3
;--- WRITE 0xBEEF TO PAGE3 AT 0x3000 ---
	LI	R2,3000H
	LI	R1,0BEEFH
	MOV	R1,*R2
;--- COPY TEST_ROUTINE TO PAGE2 AT 0x2000 ---
	LI	R1,TEST_ROUTINE		;SOURCE ADDRESS
	LI	R2,2000H		;DESTINATION
	LI	R3,TEST_REND-TEST_ROUTINE	;LENGTH IN BYTES
	SRL	R3,1			;CONVERT TO WORDS
CTCOPY:
	MOV	*R1+,*R2+
	DEC	R3
	JNE	CTCOPY
;--- CALL TEST ROUTINE AT 0x2000 ---
	LI	R2,2000H
	BL	*R2
;--- CHECK RESULT ---
	MESG	@TXT_RESULT
	WHEX	R0
	CI	R0,0BEEFH
	JEQ	CTOK
	MESG	@TXT_CTFAIL
	B	@EXIT
CTOK:	MESG	@TXT_CTOK
	MESG	@TXT_NL
	B	@EXIT

EXIT:
	LI	R9,PSEL_DISABLE		;DISABLE PSEL BEFORE RETURNING
	PSEL	R9
	BLWP	@0F004H

;*******************************************************************
;	CALC_ADDR - segment base address from SEG_PAGE
;	Exit: R2 = segment * 0x1000
;*******************************************************************
CALC_ADDR:
	MOV	@SEG_PAGE,R2
	ANDI	R2,00FFH
	SWPB	R2
	SLA	R2,4
	RT

;*******************************************************************
;	MAP_SET - R9=segment, R0=page
;*******************************************************************
MAP_SET:
	LI	MAP_PORT,MAP_BASE_PORT
	SLA	R9,1
	A	R9,MAP_PORT
	SLA	R0,8
	LDCR	R0,BYTEWIDE
	RT

;*******************************************************************
;	MAP_GET - read map register for segment
;	Entry: R9=segment  Exit: R0=page
;*******************************************************************
MAP_GET:
	LI	MAP_PORT,MAP_BASE_PORT
	SLA	R9,1			;SEGMENT * 2
	A	R9,MAP_PORT		;POINT TO SEGMENT REGISTER
	CLR	R0
	STCR	R0,BYTEWIDE		;READ FROM 6116
	SRL	R0,8			;SHIFT TO LOW BYTE
	RT

;*******************************************************************
;	Storage
;*******************************************************************
MLST_SEG:	WORD	0
WVAL:		WORD	0
WADDR:		WORD	0
WRBK:		WORD	0

;*******************************************************************
;	Messages
;*******************************************************************
TXT_BANNER:	TEXT	"CMD:1=PSEN 2=PSDIS 3=SMREG 4=RMREG 5=WPGSEG 6=RPGSEG 7=CLR"
		BYTE	0DH,0AH
		TEXT	"     8=LST 9=RDLP A=PGLP B=HLP C=SETALL D=SCYC E=INIT F=CODE"
		BYTE	0DH,0AH,0
		EVEN
TXT_HELP:	TEXT	"MAPDEBUG COMMANDS:"
		BYTE	0DH,0AH
		TEXT	"  1=PSEL_EN   ENABLE MAPPING"
		BYTE	0DH,0AH
		TEXT	"  2=PSEL_DIS  DISABLE MAPPING"
		BYTE	0DH,0AH
		TEXT	"  3=SMREG     SET MAP REG + VERIFY (0504=SEG:PAGE)"
		BYTE	0DH,0AH
		TEXT	"  4=RMREG     READ MAP REG (0504=SEG:PAGE)"
		BYTE	0DH,0AH
		TEXT	"  5=WPGSEG    WRITE TO PAGE (0504=SEG:PAGE 0506=VAL)"
		BYTE	0DH,0AH
		TEXT	"  6=RPGSEG    READ FROM PAGE (0504=SEG:PAGE)"
		BYTE	0DH,0AH
		TEXT	"  7=MAP_CLR   SET ALL SEGMENTS TO PAGE 0"
		BYTE	0DH,0AH
		TEXT	"  8=MAP_LST   LIST ALL MAP REGISTERS"
		BYTE	0DH,0AH
		TEXT	"  9=RDLOOP    CONTINUOUS READ LOOP (RESET TO EXIT)"
		BYTE	0DH,0AH
		TEXT	"  A=PGLOOP    CYCLE ALL PAGES ON SEG (RESET TO EXIT)"
		BYTE	0DH,0AH
		TEXT	"  B=HELP      THIS MESSAGE"
		BYTE	0DH,0AH
		TEXT	"  C=SETALL    SET ALL SEGS SEG N=PAGE N (0-14)"
		BYTE	0DH,0AH
		TEXT	"  D=SEGCYC    PSEL BOUNDARY CYCLE (RESET TO EXIT)"
		BYTE	0DH,0AH
		TEXT	"  E=INIT      INIT SEGS 0-14 SEG N=PAGE N, SEG15=0"
		BYTE	0DH,0AH
		TEXT	"  F=CODETEST  WRITE+CALL PAGED ROUTINE (0504=SEG:PAGE)"
		BYTE	0DH,0AH
		TEXT	"PARAMS: 0502=CMD 0504=SEG:PAGE 0506=VALUE"
		BYTE	0,0
		EVEN
TXT_BADCMD:	TEXT	"BAD CMD"
		BYTE	0
		EVEN
TXT_PSEL_EN:	TEXT	"PSEL:ENABLED"
		BYTE	0
		EVEN
TXT_PSEL_DIS:	TEXT	"PSEL:DISABLED"
		BYTE	0
		EVEN
TXT_MWRSEG:	TEXT	"MAPREG WR SEG:"
		BYTE	0
		EVEN
TXT_MRDSEG:	TEXT	"MAPREG RD SEG:"
		BYTE	0
		EVEN
TXT_PAGE:	TEXT	" PAGE:"
		BYTE	0
		EVEN
TXT_READBACK:	TEXT	"READBACK:"
		BYTE	0
		EVEN
TXT_WPGSEG:	TEXT	"WPGSEG SEG:"
		BYTE	0
		EVEN
TXT_RPGSEG:	TEXT	"RPGSEG SEG:"
		BYTE	0
		EVEN
TXT_WROTE:	TEXT	"WROTE:"
		BYTE	0
		EVEN
TXT_READ:	TEXT	"READ:"
		BYTE	0
		EVEN
TXT_MAPCLR:	TEXT	"MAP:INIT - ALL SEGS SET TO PAGE 0"
		BYTE	0
		EVEN
TXT_SEG:	TEXT	"SEG:"
		BYTE	0
		EVEN
TXT_RDLOOP:	TEXT	"RDLOOP:RESET TO EXIT"
		BYTE	0
		EVEN
TXT_DONE:	TEXT	"REGS LOADED - RUN LST TO VERIFY"
		BYTE	0
		EVEN
TXT_INIT:	TEXT	"INIT:SEG N=PAGE N (0-14), SEG15=PAGE0"
		BYTE	0
		EVEN
TXT_SEGCYC:	TEXT	"SEGCYC:RESET TO EXIT"
		BYTE	0
		EVEN
TXT_SEGLOOP:	TEXT	"SETALL:RESET TO EXIT"
		BYTE	0
		EVEN
TXT_PGLOOP:	TEXT	"PGLOOP:RESET TO EXIT"
		BYTE	0
		EVEN
TXT_CODETEST:	TEXT	"CODETEST:WRITE+CALL PAGED ROUTINE"
		BYTE	0
		EVEN
TXT_RESULT:	TEXT	" RESULT:"
		BYTE	0
		EVEN
TXT_CTOK:	TEXT	" PASS - CODE EXECUTED FROM PAGED MEMORY"
		BYTE	0
		EVEN
TXT_CTFAIL:	TEXT	" FAIL - EXPECTED ABCD"
		BYTE	0
		EVEN
TXT_NL:		BYTE	0DH,0AH,0
		EVEN

;*******************************************************************
;	TEST_ROUTINE - loaded into paged memory by CMD F
;	Reads from 0x3000 (page 3) and returns value in R0
;*******************************************************************
TEST_ROUTINE:
	LI	R2,3000H		;ADDRESS IN PAGE 3
	MOV	*R2,R0			;READ FROM PAGE 3
	RT
TEST_REND:

	END
